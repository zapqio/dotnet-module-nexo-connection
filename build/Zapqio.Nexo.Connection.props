<Project>
  <!-- Defaults are imported before the consumer project. Paths and references are
       evaluated in the matching .targets after the consumer has set its overrides. -->
  <PropertyGroup>
    <NexoSdkVersion Condition="'$(NexoSdkVersion)' == ''">61.1.0.9431</NexoSdkVersion>
    <NexoSdkCopyLocal Condition="'$(NexoSdkCopyLocal)' == ''">false</NexoSdkCopyLocal>
  </PropertyGroup>
</Project>
