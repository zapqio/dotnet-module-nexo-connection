<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="build\Zapqio.Nexo.Connection.props" />

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<DeterministicSourcePaths>true</DeterministicSourcePaths>

		<!-- Paczka NuGet: API do kompilacji dla modułów konsumenckich (PackageReference z ExcludeAssets="runtime").
		     W runtime Connection jest w Nexo.Connection.zip, a SDK w osobnym Nexo.Sdk.zip w Modules\ runnera. -->
		<PackageId>Zapqio.Nexo.Connection</PackageId>
		<Version>1.1.3</Version>
		<!-- Tożsamość własnego zestawu pozostaje stała w ramach zgodnego API.
		     Referencje InsERT nadal muszą pasować do SDK. Podbić przy zmianie łamiącej API. -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Authors>Zapqio</Authors>
		<Company>Hdwr global</Company>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/zapqio/dotnet-module-nexo-connection</PackageProjectUrl>
		<RepositoryUrl>https://github.com/zapqio/dotnet-module-nexo-connection</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>NUGET.md</PackageReadmeFile>
		<PackageTags>zapqio;nexo;subiekt;integration</PackageTags>
		<PackageReleaseNotes>Fix SDK version and path overrides in consumer projects; validate missing SDK files. Apache-2.0, Module.Core 1.2.0. No public API changes.</PackageReleaseNotes>
		<Description>Shared InsERT nexo (Subiekt) connection for Zapqio Runner modules: one NexoClient singleton injected into consumer modules, plus the nexo SDK references for compiling them.</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<!-- SDK ma osobną paczkę Nexo.Sdk.zip. Updater przebudowuje Connection i konsumentów
		     przeciw docelowemu SDK, bez zmiany wersji API/pakietu Connection. Lokalne warianty
		     mają oddzielne źródła NuGet i cache; nie są publikowane ponownie na nuget.org. -->
		<NexoSdkCopyLocal>false</NexoSdkCopyLocal>
	</PropertyGroup>

	<!-- Te same ustawienia i referencje SDK są pakowane dla projektów konsumenckich. -->
	<ItemGroup>
		<None Include="build\Zapqio.Nexo.Connection.props" Pack="true" PackagePath="build\" />
		<None Include="build\Zapqio.Nexo.Connection.targets" Pack="true" PackagePath="build\" />
		<None Include="LICENSE" Pack="true" PackagePath="/" CopyToOutputDirectory="PreserveNewest" />
		<None Include="NUGET.md" Pack="true" PackagePath="/" />
		<!-- Skrypt podmiany SDK jedzie w zipie; NexoClient kopiuje go do katalogu runnera (automatyczna podmiana). -->
		<None Include="update-nexo-sdk.ps1" CopyToOutputDirectory="PreserveNewest" />
		<None Include="build-nexo-set.ps1" CopyToOutputDirectory="PreserveNewest" />
		<None Include="install-nexo-build.ps1" CopyToOutputDirectory="PreserveNewest" />
		<PackageReference Include="Zapqio.Runner.Module.Core" Version="1.2.0" ExcludeAssets="runtime" />
	</ItemGroup>

	<Import Project="build\Zapqio.Nexo.Connection.targets" />

	<!-- Preserve this exact source version for future SDK rebuilds, including offline updates. -->
	<Target Name="PrepareNexoRebuildSource" BeforeTargets="ComputeFilesToPublish">
		<PropertyGroup>
			<NexoRebuildSourceDir>$(IntermediateOutputPath)nexo-source\</NexoRebuildSourceDir>
			<NexoRebuildSourceZip>$(IntermediateOutputPath)nexo-source.zip</NexoRebuildSourceZip>
		</PropertyGroup>
		<ItemGroup>
			<_NexoRootSource Include="*.cs;*.ps1;$(MSBuildProjectFile);LICENSE;NUGET.md" />
			<_NexoBuildSource Include="build\*.props;build\*.targets" />
		</ItemGroup>
		<RemoveDir Directories="$(NexoRebuildSourceDir)" />
		<MakeDir Directories="$(NexoRebuildSourceDir)build" />
		<Copy SourceFiles="@(_NexoRootSource)" DestinationFolder="$(NexoRebuildSourceDir)" />
		<Copy SourceFiles="@(_NexoBuildSource)" DestinationFolder="$(NexoRebuildSourceDir)build" />
		<ZipDirectory SourceDirectory="$(NexoRebuildSourceDir)" DestinationFile="$(NexoRebuildSourceZip)" Overwrite="true" />
		<ItemGroup>
			<ResolvedFileToPublish Include="$(NexoRebuildSourceZip)" RelativePath="nexo-source.zip" CopyToPublishDirectory="Always" />
		</ItemGroup>
	</Target>

	<!--Zip after publish-->
	<Target Name="ZipAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<ZipFileName>$(MSBuildProjectName).zip</ZipFileName>
			<ZipFilePath>$(PublishDir)..\$(ZipFileName)</ZipFilePath>
		</PropertyGroup>
		<!--Lista bibliotek, ktore runner ma skanowac; bez niej laduje wszystkie ~550 dll z paczki-->
		<WriteLinesToFile File="$(PublishDir)##Dll" Lines="$(TargetFileName)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<!--Moduł współdzielony: inne paczki w Modules\ mogą brać z tego katalogu biblioteki (NexoClient, SDK)-->
		<WriteLinesToFile File="$(PublishDir)##Shared" Lines="shared" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<Delete Files="$(ZipFilePath)" Condition="Exists('$(ZipFilePath)')" />
		<ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipFilePath)" />
		<Message Importance="High" Text="Created: $(ZipFilePath)" />
	</Target>

</Project>
